{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["dockerfile", "github-actions", "custom.regex"],
  "ignorePaths": [".devcontainer/**"],
  "constraints": {
    "ghActionsLock": "v0.5.1"
  },
  "customManagers": [
    {
      "description": "Update the Home Assistant CLI version pinned via ARG CLI_VERSION in the Dockerfile",
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG CLI_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "home-assistant/cli",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "description": "Keep gh-actions-lock in CI and Renovate's lockfile generator on the same version",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/actions-lock\\.yml$/",
        "/^\\.github/renovate\\.json$/"
      ],
      "matchStrings": [
        "GH_ACTIONS_LOCK_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "\"ghActionsLock\": \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-assistant/base"],
      "versionCompatibility": "^3\\.24-(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "pep440",
      "sourceUrl": "https://github.com/home-assistant/docker-base",
      "groupName": "docker-base",
      "commitMessageTopic": "home-assistant/base image",
      "commitMessageExtra": "to {{newValue}}"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["home-assistant/cli"],
      "description": "Match the manual bump PRs: \"Bump CLI to v5.5.0\"",
      "commitMessageAction": "Bump",
      "commitMessageTopic": "CLI",
      "commitMessageExtra": "to v{{newValue}}"
    },
    {
      "description": "Label GitHub Actions updates like Dependabot did",
      "matchManagers": ["github-actions"],
      "labels": ["dependencies", "github_actions"]
    },
    {
      "description": "Leave runner labels and action version inputs alone, Dependabot never updated those",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner", "uses-with"],
      "enabled": false
    },
    {
      "description": "Group the home-assistant/builder subactions into one PR (they share a release)",
      "matchPackageNames": ["/^home-assistant\\/builder(?:\\/|$)/"],
      "groupName": "home-assistant/builder",
      "groupSlug": "builder"
    }
  ]
}
