# ha REPL rcfile

# Prompt
PS1='\[\e[32m\]ha > \[\e[0m\]'

# Ignore EOF (Ctrl+D) so it does not exit the REPL
set -o ignoreeof

# Disable history expansion so '!' in arguments reaches ha verbatim
set +H

# List completion candidates one per line - the completion descriptions
# make readline's multi-column layout hard to read on wide terminals
bind "set completion-display-width 0"

# Intercept unknown commands and pass them to 'ha'
command_not_found_handle() {
    if ! command -v ha >/dev/null 2>&1; then
        echo "bash: $1: command not found" >&2
        return 127
    fi
    ha "$@"
}

# Friendly helpers
help() {
    if [ $# -eq 0 ]; then
        echo 'Note: Use "login" to enter operating system shell'
        echo ''
        echo '--------------------------------'
    fi
    ha help "$@"
}

login() {
    echo 'Entering OS shell...'
    exit 10
}

# 'jobs' is both a Bash builtin and an ha command - disable the builtin so it
# falls through to command_not_found_handle like other ha commands
enable -n jobs

if command -v ha >/dev/null 2>&1; then
    # Load bash-completion if the system bashrc did not already do it: it
    # provides helper functions used by the generated ha completion and
    # sources it from /etc/bash_completion.d
    if ! declare -F _get_comp_words_by_ref >/dev/null 2>&1 \
            && [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    fi

    # Wrapper function to inject 'ha' as first argument for all completions
    if declare -F __start_ha >/dev/null 2>&1; then
        # Clear all existing completions to ensure our wrapper is used
        complete -r

        # Universal completion handler - wraps everything as 'ha ...'
        __ha_repl_complete() {
            if [[ ${COMP_WORDS[0]} == "ha" ]]; then
                # Explicit 'ha ...' - complete as-is, no prefixing needed
                COMPREPLY=()
                __start_ha
                return
            elif [[ ${#COMP_WORDS[@]} -eq 0 || ( ${#COMP_WORDS[@]} -eq 1 && -z "${COMP_WORDS[0]}" ) ]]; then
                # Handle empty command line specially
                COMP_LINE="ha "
                COMP_POINT=3
                COMP_WORDS=(ha "")
                COMP_CWORD=1
            else
                # Prepend 'ha' to existing words
                COMP_LINE="ha $COMP_LINE"
                COMP_POINT=$((COMP_POINT + 3))
                COMP_WORDS=(ha "${COMP_WORDS[@]}")
                COMP_CWORD=$((COMP_CWORD + 1))
            fi

            COMPREPLY=()
            __start_ha
        }

        # Register our completion as the default for everything
        complete -D -F __ha_repl_complete  # Default for any command
        complete -E -F __ha_repl_complete  # Empty command line
        complete -I -F __ha_repl_complete 2>/dev/null || true  # Initial word (bash 5+)
    fi
else
    echo 'Warning: ha command not found; commands will fail' >&2
fi

# Run one REPL input line. The raw line is handed to ha via xargs like the
# old rlwrap REPL did, so shell expansions ($, !, *, ...) never happen and
# arguments (e.g. passwords containing $) reach ha verbatim.
__ha_run() {
    local line=$1 args
    # Trim surrounding whitespace
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z $line ]] && return 0
    case $line in
        exit) exit 0 ;;
        login|login\ *) login; return ;;
        help|help\ *)
            read -ra args <<< "${line#help}"
            help "${args[@]}"
            return ;;
    esac
    printf '%s\n' "$line" | /usr/bin/xargs -o ha
}

# Accept-line replacement: consume the readline buffer without letting Bash
# parse it, keep it in the history, and execute it through __ha_run with a
# sane terminal state
__ha_accept() {
    local line=$READLINE_LINE _saved
    READLINE_LINE=''; READLINE_POINT=0
    printf '\n'
    [[ -n $line ]] && history -s "$line"
    _saved=$(/bin/stty -g); /bin/stty sane
    __ha_run "$line"
    /bin/stty "$_saved"
}

bind -x '"\C-m": __ha_accept'
bind -x '"\C-j": __ha_accept'

# Unbind readline functions that accept or execute the line behind
# __ha_accept's back (operate-and-get-next, edit-and-execute-command)
bind -r "\C-o"
bind -r "\C-x\C-e"

# Backstop hardening in case a line still reaches Bash's parser through an
# unanticipated readline path: keep '!' and '*' unexpanded and only expose
# the ha binary, so stray commands fall through to command_not_found_handle
# and are executed as ha commands. Use "login" for a full shell on the host.
set -f
PATH=/usr/share/ha-cli/bin
readonly PATH
hash -r
